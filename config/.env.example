TELEGRAM_TOKEN=your_bot_token_here

# Optional: Postgres connection string (e.g. from a free Neon/Supabase project).
# Set this on hosts with an ephemeral filesystem (like Render's free tier) so
# profiles/bans/etc. survive restarts and redeploys. Leave unset locally to
# keep using the SQLite file in bot_storage/.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
